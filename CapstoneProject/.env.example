# Google ADK / Gemini
GOOGLE_API_KEY=your_google_api_key_here

# GitLab
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=your_gitlab_personal_access_token
GITLAB_PROJECT_ID=your_project_id_number

# Project root (absolute path to the devloop folder)
PROJECT_ROOT=/path/to/devloop

# MCP Server API key — protects all MCP tool calls from unauthorized access
# Set to any random secret string (e.g. openssl rand -hex 16)
MCP_API_KEY=your_mcp_api_key_here
